@model PeliculaCatalogo
@{
    var usuario = Context.Session.ObtenerUsuario();
}
<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@Model.Titulo</h5>
        <p class="mb-2">
            <span class="badge bg-secondary">@Model.Clasificacion</span>
            @if (Model.Anio is not null) { <span class="text-muted small">@Model.Anio</span> }
            <span class="text-muted small">· @Model.Duracion min · $@Model.Tarifa.ToString("0.00")</span>
        </p>
        @if (Model.Disponible)
        {
            <span class="badge bg-success">Disponible: @Model.CopiasDisponibles de @Model.TotalCopias copias</span>
        }
        else
        {
            <span class="badge bg-danger">No disponible (@Model.TotalCopias copias)</span>
        }
    </div>
    <div class="card-footer bg-white d-flex flex-wrap gap-1">
        <a class="btn btn-sm btn-primary" asp-controller="Peliculas" asp-action="Detalle" asp-route-id="@Model.Id">Detalle</a>
        @if (usuario?.EsAdministrador == true)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Peliculas" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Inventario" asp-action="Index" asp-route-peliculaId="@Model.Id">Copias</a>
            <form asp-controller="Peliculas" asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('¿Retirar esta película del catálogo?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
            </form>
        }
    </div>
</div>
